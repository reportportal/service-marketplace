{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marketplace.reportportal.io/schemas/marketplace-manifest.schema.json",
  "title": "ReportPortal marketplace-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "category",
    "compatibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[\\w.-]+)?(?:\\+[\\w.-]+)?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "license": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["bug-tracking", "notifications", "authorization", "import"]
    },
    "compatibility": {
      "type": "object",
      "required": ["reportportal"],
      "additionalProperties": false,
      "properties": {
        "reportportal": { "type": "string", "minLength": 1 }
      }
    },
    "homepage": { "type": "string", "format": "uri" },
    "access": {
      "type": "string",
      "enum": ["public", "premium"],
      "default": "public"
    },
    "contactUrl": { "type": "string", "format": "uri" }
  },
  "if": {
    "properties": { "access": { "const": "premium" } },
    "required": ["access"]
  },
  "then": {
    "required": ["contactUrl"]
  }
}
